# ============================================================
#  PetCare AI — Root .gitignore
#  CRITICAL: Protect credentials, secrets, build artifacts & dependencies
# ============================================================

# ── Environment & Secrets (NEVER COMMIT) ────────────────────
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.pfx

# ── Dependencies ─────────────────────────────────────────────
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Python & Virtual Environments ───────────────────────────
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/

# ── Databases & Vector Stores ───────────────────────────────
chroma_db_data/
*/chroma_db_data/
*.sqlite
*.sqlite3
*.db
*.rdb

# ── Build Artifacts ─────────────────────────────────────────
frontend/dist/
frontend/dist-ssr/
backend/dist/
dist/

# ── IDE & Editor Folders ─────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Agentic & Local Cache Directories ───────────────────────
.agents/
.cache/
.system_generated/
*.log
logs/

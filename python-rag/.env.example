# ============================================================
#  Python RAG Microservice Environment Configuration
#  Copy this file to .env and configure with your keys.
#  NEVER commit real .env files to GitHub.
# ============================================================

PYTHON_RAG_PORT=8002
HOST=0.0.0.0

# ── LLM Gateway ─────────────────────────────────────────────
# Provider options: gemini | openrouter
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CONVERSATION_MODEL=google/gemma-4-26b-a4b-it:free
ANSWER_MODEL=google/gemma-4-26b-a4b-it:free
EMBEDDING_MODEL=openai/text-embedding-3-small

# ── Vector DB & Storage ─────────────────────────────────────
CHROMADB_URL=http://localhost:8000
CHROMA_COLLECTION=vetknowledge
MONGODB_URI=your_mongodb_atlas_connection_string_here
MONGODB_DB_NAME=petcareai

# ── LangSmith Tracing & Observability ────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=vetbot-langgraph
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── API Security ─────────────────────────────────────────────
API_KEY_PROTECTION=false
CLIENT_API_KEY=vetbot-client-secret
INGEST_API_KEY=vetbot-internal-secret

# ============================================================
#  PetCare AI — Backend Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to GitHub.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=petcareai-super-secret-change-in-production

# ── MongoDB ─────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/petcareai?retryWrites=true&w=majority

# ── Google Gemini API (Recommended: Free & fast) ───────────
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# ── OpenRouter (get key at https://openrouter.ai) ───────────
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── AI Model Selection ───────────────────────────────────────
# Conversation + Answer generation model (fast, cheap)
CONVERSATION_MODEL=google/gemini-flash-1.5
# Vision-capable model (must support image input)
VISION_MODEL=openai/gpt-4o
# Answer generation (can be same as CONVERSATION_MODEL)
ANSWER_MODEL=google/gemini-flash-1.5
# Reviewer model (called only on high-risk responses)
REVIEWER_MODEL=anthropic/claude-3-haiku
# Embedding model
EMBEDDING_MODEL=openai/text-embedding-3-small

# ── ChromaDB ─────────────────────────────────────────────────
CHROMADB_URL=http://localhost:8000
CHROMA_COLLECTION=vetknowledge

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Image Upload ─────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ── n8n Webhook (optional — use node-cron for dev) ──────────
N8N_WEBHOOK_URL=http://localhost:5678/webhook/petcare-reminder
N8N_WEBHOOK_SECRET=petcareai-n8n-secret-change-in-production

# ── Reminder Notifications ───────────────────────────────────
# Options: in-app | email (configure email below if needed)
NOTIFICATION_CHANNEL=in-app
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password

# Python NLP & RAG Microservice
USE_PYTHON_RAG=true
PYTHON_RAG_URL=http://localhost:8002

